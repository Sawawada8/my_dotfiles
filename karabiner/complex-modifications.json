{
    "description": "Map ctrl+b/f -> left/right arrow, ctrl+m to back, ctrl+p/n -> up/down",
    "manipulators": [
        {
            "from": {
                "key_code": "b",
                "modifiers": { "mandatory": ["control"] }
            },
            "to": [{ "key_code": "left_arrow" }],
            "type": "basic"
        },
        {
            "from": {
                "key_code": "f",
                "modifiers": { "mandatory": ["control"] }
            },
            "to": [{ "key_code": "right_arrow" }],
            "type": "basic"
        },
        {
            "from": {
                "key_code": "m",
                "modifiers": { "mandatory": ["control"] }
            },
            "to": [{ "key_code": "left_arrow" }],
            "type": "basic"
        },
        {
            "from": {
                "key_code": "p",
                "modifiers": { "mandatory": ["control"] }
            },
            "to": [{ "key_code": "up_arrow" }],
            "type": "basic"
        },
        {
            "from": {
                "key_code": "n",
                "modifiers": { "mandatory": ["control"] }
            },
            "to": [{ "key_code": "down_arrow" }],
            "type": "basic"
        }
    ]
}
